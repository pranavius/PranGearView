<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="PGVOptionsSpacerTemplate" virtual="true">
        <Size y="10"/>
    </Frame>

    <Frame name="PGVOptionsDescriptionTemplate" mixin="PGVOptionsDescriptionMixin" virtual="true">
        <Size y="25"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="10" y="-10"/>
                        <Anchor point="TOPRIGHT" x="-10" y="-10"/>
                    </Anchors>
                    <Color color="WHITE_FONT_COLOR"/>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="PGVOptionsCompactDescriptionTemplate" mixin="PGVOptionsDescriptionMixin" virtual="true">
        <Size y="15"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="LEFT" x="10"/>
                        <Anchor point="RIGHT" x="-10"/>
                    </Anchors>
                    <Color color="WHITE_FONT_COLOR"/>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="PGVOptionsCopyTextTemplate" mixin="PGVOptionsCopyTextMixin" virtual="true">
        <Size y="25"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Label" inherits="GameFontHighlight" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" x="10"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <EditBox parentKey="EditBox" inherits="InputBoxTemplate" autoFocus="false" letters="150">
                <Size x="250" y="25"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.Label" relativePoint="RIGHT" x="10"/>
                </Anchors>
                <Scripts>
                    <OnEditFocusGained function="EditBox_HighlightText"/>
                    <OnEscapePressed function="EditBox_ClearFocus"/>
                </Scripts>
            </EditBox>
        </Frames>
    </Frame>
</Ui>
