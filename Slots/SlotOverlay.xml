<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="PGVSlotOverlayTemplate" mixin="PGVSlotOverlayMixin" setAllPoints="true" virtual="true">
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="EmbellishmentShadow" file="Interface/Buttons/WHITE8x8" setAllPoints="true" hidden="true">
                    <Color color="BLACK_FONT_COLOR" a="0.3"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="ItemLevel" inherits="GameTooltipText" hidden="true"/>
                <FontString parentKey="UpgradeTrack" inherits="GameTooltipText" hidden="true"/>
                <FontString parentKey="Gems" inherits="GameTooltipText" hidden="true"/>
                <FontString parentKey="Enchant" inherits="GameTooltipText" hidden="true"/>
                <FontString parentKey="Durability" inherits="GameTooltipText" hidden="true"/>
                <Texture parentKey="Embellishment" file="Interface/LootFrame/Toast-Star" hidden="true">
                    <Size x="21" y="21"/>
                    <Color r="0" g="1" b="0.6" a="1"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <StatusBar parentKey="DurabilityBar" inherits="BackdropTemplate" hidden="true">
                <Size y="4"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" x="2" y="2"/>
                    <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
                </Anchors>
                <BarTexture file="Interface/Buttons/WHITE8x8"/>
            </StatusBar>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
